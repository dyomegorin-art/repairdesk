# Copy to .env and fill locally. Never commit real values.

# local | test | staging | production
APP_ENV=

# Must stay empty/false outside local and test; startup fails otherwise.
ALLOW_LOCAL_SYNTHETIC_AUTH=

# Shared secret expected in X-Intake-Webhook-Key
INTAKE_WEBHOOK_KEY=

# Password for the local Postgres container (docker-compose.yml)
POSTGRES_PASSWORD=

# Used outside Compose only (Compose builds its own URL). Example form:
# postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=
